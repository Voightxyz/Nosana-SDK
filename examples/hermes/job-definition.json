{
  "version": "0.1",
  "type": "container",
  "meta": {
    "trigger": "dashboard"
  },
  "ops": [
    {
      "type": "container/run",
      "id": "hermes-on-nosana",
      "args": {
        "image": "docker.io/seenfinity/hermes-nosana:latest",
        "gpu": true,
        "expose": 8642,
        "env": {
          "VOIGHT_API_KEY": "REPLACE_WITH_VOIGHT_API_KEY",
          "OPENROUTER_API_KEY": "OPTIONAL_CAPPED_KEY_FOR_LIVE_CHAT"
        }
      }
    }
  ]
}
